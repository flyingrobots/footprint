# graft reaches roaring through git-warp 16, where it is a hard dependency. roaring ships no
# prebuild for Node 26's module version, so node-pre-gyp tries to compile and make exits 2.
# Nothing on the structural-analysis path uses roaring's native module, so skip install scripts
# and the whole problem disappears. Bun already blocks untrusted postinstalls by default.
#
# This does not affect `npm run`; only dependency install scripts.
ignore-scripts=true
