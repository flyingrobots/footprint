{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyingrobots.dev/footprint/schemas/footprint.overlap/2.3.0",
  "title": "footprint.overlap 2.3.0",
  "description": "The fourth result of a footprint run: which open pull requests touch a file this change touches, the conflict graph between the open pull requests, and a proposed merge order as waves. Every figure comes from gh pr list --json and gh pr diff --name-only; each shared file of a pair is also compared at the symbol level, from git diff -U0 and graft read outline's jump table at each side's merge base and head (flyingrobots/footprint#33). When gh cannot answer, available is false and the reason is stated rather than the section being omitted.",
  "type": "object",
  "required": [
    "event",
    "t",
    "seq",
    "run",
    "range",
    "overlap",
    "digest",
    "_schema"
  ],
  "properties": {
    "event": {
      "const": "result"
    },
    "t": {
      "type": "integer",
      "minimum": 0
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "range": {
      "type": "string",
      "minLength": 1,
      "description": "The git range whose files were compared against the open pull requests"
    },
    "overlap": {
      "type": "object",
      "required": [
        "available",
        "summary"
      ],
      "oneOf": [
        {
          "properties": {
            "available": {
              "const": true
            }
          },
          "required": [
            "self",
            "openPullRequests",
            "limit",
            "truncated",
            "overlapping",
            "conflicts",
            "waves",
            "undetermined",
            "symbolAnalysis",
            "baseMerge",
            "mergeAnalysis"
          ]
        },
        {
          "properties": {
            "available": {
              "const": false
            }
          },
          "required": [
            "code",
            "reason"
          ]
        }
      ],
      "properties": {
        "available": {
          "type": "boolean",
          "description": "False when gh is absent, unauthenticated, rate-limited or unreadable; the section is stated, never omitted"
        },
        "code": {
          "enum": [
            "gh.not_found",
            "gh.unauthenticated",
            "gh.rate_limited",
            "gh.no_remote",
            "gh.list_failed",
            "gh.list_unreadable"
          ],
          "description": "Why the overlap is unavailable; present only when available is false"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "gh's own message, or why gh could not be found"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "The plain statement: the counts, or that there is no overlap, or the limitation. Never an empty section."
        },
        "self": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The pull request under review: the open pull request whose head commit is the range's head commit, or, when no head commit matches, the same-repository pull request whose head branch is the range's head branch. Excluded from overlapping and kept in the waves; always present, null when none matches."
        },
        "openPullRequests": {
          "type": "integer",
          "minimum": 0,
          "description": "How many open pull requests gh listed"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "The gh pr list --limit used"
        },
        "truncated": {
          "type": "boolean",
          "description": "True when the list came back at the limit, so there may be more open pull requests than were considered"
        },
        "overlapping": {
          "type": "array",
          "description": "Open pull requests that change a file this change changes, ascending by number",
          "items": {
            "type": "object",
            "required": [
              "number",
              "title",
              "isDraft",
              "sharedFiles",
              "symbolLevel",
              "merge"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string"
              },
              "isDraft": {
                "type": "boolean",
                "description": "An observation, not a verdict"
              },
              "sharedFiles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "symbolLevel": {
                "$ref": "#/$defs/symbolLevel",
                "description": "The shared files at the symbol level; side a is this change, side b this pull request"
              },
              "merge": {
                "$ref": "#/$defs/merge",
                "description": "This change's head merged with this pull request's head."
              }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "description": "One edge per pair of open pull requests that change the same file, with the files named and each compared at the symbol level",
          "items": {
            "type": "object",
            "required": [
              "a",
              "b",
              "sharedFiles",
              "reason",
              "symbolLevel",
              "merge"
            ],
            "properties": {
              "a": {
                "type": "integer",
                "minimum": 1
              },
              "b": {
                "type": "integer",
                "minimum": 1
              },
              "sharedFiles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Why the edge exists, in prose"
              },
              "symbolLevel": {
                "$ref": "#/$defs/symbolLevel",
                "description": "The shared files at the symbol level. A symbol-disjoint edge is reported and does not separate waves; it is not a claim that git will merge the two cleanly"
              },
              "merge": {
                "$ref": "#/$defs/merge",
                "description": "The two heads merged. A conflict separates waves; a clean merge does not; unavailable falls back to the symbol level."
              }
            }
          }
        },
        "waves": {
          "type": "array",
          "description": "The proposed merge order. No two pull requests in a wave share a file unless the edge between them is symbol-disjoint; an undetermined or overlapping edge separates them. Wave N+1 lands after wave N. Greedy first-fit, so a proposal rather than a minimum.",
          "items": {
            "type": "object",
            "required": [
              "wave",
              "pullRequests"
            ],
            "properties": {
              "wave": {
                "type": "integer",
                "minimum": 1
              },
              "pullRequests": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "undetermined": {
          "type": "array",
          "description": "Open pull requests whose changed files gh would not report. Kept out of the conflict graph and the waves rather than assumed disjoint.",
          "items": {
            "type": "object",
            "required": [
              "number",
              "title",
              "reason"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "symbolAnalysis": {
          "type": "object",
          "required": [
            "outlinesRun",
            "outlineBudget",
            "outlineTimeoutMs",
            "remoteCalls",
            "remoteBudget",
            "remoteTimeoutMs"
          ],
          "additionalProperties": false,
          "description": "How the symbol level was bounded this run: graft outline calls started, the most a run may start, and the timeout on each; and the same three for the read-only gh api calls that read a pull request whose commits are not in the local clone (flyingrobots/footprint#55). All zero when no analysis was run.",
          "properties": {
            "outlinesRun": {
              "type": "integer",
              "minimum": 0
            },
            "outlineBudget": {
              "type": "integer",
              "minimum": 0
            },
            "outlineTimeoutMs": {
              "type": "integer",
              "minimum": 0
            },
            "remoteCalls": {
              "type": "integer",
              "minimum": 0
            },
            "remoteBudget": {
              "type": "integer",
              "minimum": 0
            },
            "remoteTimeoutMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "baseMerge": {
          "$ref": "#/$defs/merge",
          "description": "This change's head merged with the current tip of its base."
        },
        "mergeAnalysis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fetch",
            "mergesRun",
            "mergeBudget",
            "mergeTimeoutMs",
            "fetched",
            "fetchBudget",
            "fetchTimeoutMs"
          ],
          "description": "How the merges were bounded this run: whether a missing pull request head was fetched read-only (false with --no-fetch), merges run and the most a run may run, fetches made and the most it may make, and the timeout on each.",
          "properties": {
            "fetch": {
              "type": "boolean"
            },
            "mergesRun": {
              "type": "integer",
              "minimum": 0
            },
            "mergeBudget": {
              "type": "integer",
              "minimum": 0
            },
            "mergeTimeoutMs": {
              "type": "integer",
              "minimum": 0
            },
            "fetched": {
              "type": "integer",
              "minimum": 0
            },
            "fetchBudget": {
              "type": "integer",
              "minimum": 0
            },
            "fetchTimeoutMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 over the canonical JSON of range and overlap (spec §7.1). Unlike inv, it moves with the live state of the open pull requests."
    },
    "_schema": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "footprint.overlap"
        },
        "version": {
          "const": "2.3.0"
        }
      }
    }
  },
  "$defs": {
    "touched": {
      "type": "object",
      "required": [
        "symbols",
        "outside"
      ],
      "additionalProperties": false,
      "properties": {
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The top-level symbols whose spans hold one of this side's changed lines, at the merge base for removed lines and at the head for added ones, sorted. A rename names both the old and the new symbol."
        },
        "outside": {
          "type": "integer",
          "minimum": 0,
          "description": "Changed lines outside every top-level symbol (comments, imports, top-level code), counted as git diff --numstat counts them: a modified line is one removed and one added. Whitespace-only lines are not counted."
        }
      }
    },
    "fileLevel": {
      "type": "object",
      "required": [
        "path",
        "level"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "level": {
              "const": "symbol-disjoint"
            }
          },
          "required": [
            "a",
            "b"
          ]
        },
        {
          "properties": {
            "level": {
              "const": "symbol-overlapping"
            }
          },
          "required": [
            "a",
            "b",
            "shared"
          ]
        },
        {
          "properties": {
            "level": {
              "const": "undetermined"
            }
          },
          "required": [
            "code",
            "reason"
          ]
        }
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "symbol-disjoint",
            "symbol-overlapping",
            "undetermined"
          ]
        },
        "a": {
          "$ref": "#/$defs/touched",
          "description": "Side a: this change in overlapping, the edge's a in conflicts"
        },
        "b": {
          "$ref": "#/$defs/touched",
          "description": "Side b: the other pull request in overlapping, the edge's b in conflicts"
        },
        "shared": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The symbols both sides change"
        },
        "code": {
          "enum": [
            "symbols.not_analysed",
            "graft.not_resolved",
            "language.unsupported",
            "graft.outline_failed",
            "graft.outline_timeout",
            "graft.outline_refused",
            "graft.outline_partial",
            "graft.outline_unreadable",
            "budget.spent",
            "gh.head_unknown",
            "gh.head_moved",
            "gh.base_unknown",
            "git.head_missing",
            "git.base_missing",
            "git.merge_base",
            "git.diff_failed",
            "git.show_failed",
            "git.binary",
            "symbols.outside",
            "symbols.file_unchanged",
            "gh.remote_failed",
            "gh.rate_limited",
            "gh.timeout",
            "gh.budget_spent",
            "gh.compare_unpinned",
            "gh.compare_incomplete",
            "gh.patch_unavailable",
            "gh.content_too_large"
          ],
          "description": "Why the symbol level could not be decided; present only when undetermined"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "github": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "a",
              "b"
            ]
          },
          "description": "The sides read over the GitHub API (gh api compare and contents, by exact commit id) because their commits are not in the local clone; absent when every side was read from local git"
        }
      }
    },
    "symbolLevel": {
      "type": "object",
      "required": [
        "level",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "symbol-disjoint",
            "symbol-overlapping",
            "undetermined"
          ],
          "description": "symbol-overlapping when any shared file is; symbol-disjoint only when every shared file is; otherwise undetermined"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fileLevel"
          }
        }
      }
    },
    "merge": {
      "description": "git merge-tree --write-tree on two commits (2.3.0, flyingrobots/footprint#80): clean, conflicted with the conflicted paths, or unavailable with a code and the reason. Textual evidence: a clean merge is not proof that the two changes work together.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "result"
          ],
          "additionalProperties": false,
          "properties": {
            "result": {
              "const": "clean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "result",
            "paths"
          ],
          "additionalProperties": false,
          "properties": {
            "result": {
              "const": "conflicted"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "result",
            "code",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "result": {
              "const": "unavailable"
            },
            "code": {
              "enum": [
                "merge.not_run",
                "merge.budget_spent",
                "git.merge_tree_unsupported",
                "git.merge_tree_failed",
                "git.timeout",
                "git.head_missing",
                "git.fetch_failed",
                "git.head_moved"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
